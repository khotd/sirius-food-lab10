# Пример файла с секретами. Скопируйте в .env и подставьте свои значения.
# .env не попадает в Git (см. .gitignore) — это принцип Secure by Default.

# Секрет для подписи JWT. Сменить в продакшене!
SECRET_KEY=change-me-to-a-long-random-string

# Подключение к PostgreSQL из docker-compose
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food

# Хост-порт контейнера PostgreSQL (нужен, только если 5432 занят другим
# PostgreSQL на вашей машине; не забудьте указать его и в DATABASE_URL)
# DB_PORT=5433

# Redis для rate limiting и кеша меню (docker compose up -d redis).
# Если 6379 занят локальной службой Redis, задайте REDIS_PORT=6380
# и такой же порт в REDIS_URL (docker-compose прочитает REDIS_PORT).
# REDIS_PORT=6380
REDIS_URL=redis://localhost:6379

# Кеширование меню на Redis (ЛР № 4). false — режим baseline:
# каждый запрос к меню идёт в PostgreSQL (для замеров «до кеша»)
CACHE_ENABLED=true

# API-окружение:
#   DEBUG=True  — локальная разработка: Swagger на /docs включён
#   DEBUG=False — продакшен: Swagger отключён (Secure by Default)
DEBUG=True

# Разрешённые CORS-источники через запятую (пустое значение —
# браузерные запросы с внешних доменов запрещены).
ALLOWED_ORIGINS=https://sirius-food.ru,https://app.sirius-food.ru

# Микросервис доставки (ЛР № 6): сервер и клиент читают один источник.
# Порт 50061, а не 50051: на Windows с Hyper-V диапазон 50000–50059
# часто зарезервирован (netsh int ipv4 show excludedportrange protocol=tcp).
DELIVERY_SERVICE_HOST=localhost
DELIVERY_SERVICE_PORT=50061

# RabbitMQ (ЛР № 7). При смене хостового порта обновите и URL.
RABBITMQ_URL=amqp://sirius:sirius@127.0.0.1:5672/
# RABBITMQ_PORT=5672
# RABBITMQ_UI_PORT=15672
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# Учебная практика A + D. Только ключ sk_test_, реальные платежи запрещены.
STRIPE_SECRET_KEY=
# Значение whsec_... из stripe listen или тестового webhook endpoint.
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=rub
# Для команды python -m scripts.seed_practice задайте свой учебный пароль.
PRACTICE_DEMO_PASSWORD=
# API_PORT=8000
